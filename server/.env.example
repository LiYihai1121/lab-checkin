# 实验室签到系统后端环境变量模板
#
# 用法：复制为 server/.env 后按需取消注释修改。
#   cp server/.env.example server/.env
# npm run dev / npm start 会自动加载 server/.env（Node 内置 --env-file-if-exists，
# 文件不存在时照常启动，需 Node >= 22.9）。.env 已被 git 忽略，不会入库。
#
# 开发环境：以下全部可省略，默认值即可正常开发。
# 测试环境：由 server/tests/setup.js 自动注入，不读取本文件。

# ---------- 通用 ----------
# 运行环境标识；设为 production 时强制校验 JWT_SECRET，缺失则拒绝启动
# NODE_ENV=development

# ---------- 开发环境（全部有默认值，按需覆盖） ----------
# 后端监听端口（默认 3000；前端开发代理默认指向该端口）
# PORT=3000
# SQLite 数据库文件路径（默认 server/data/lab-checkin.db；:memory: 为内存库）
# DB_PATH=

# ---------- 生产环境（逐项检查） ----------
# JWT 签名密钥，生产必填。生成示例：
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
# 允许的前端来源，多个用英文逗号分隔；不设置则放行所有来源
# CORS_ORIGIN=https://lab.example.com
# 经 Nginx 等反向代理部署时设为 true（或填代理跳数），限流按真实客户端 IP 计数
# TRUST_PROXY=true
# 首次启动建好管理员后建议设为 false，避免清空数据库后重建默认管理员
# CREATE_DEFAULT_ADMIN=false
# 首次建库时默认管理员 admin 的初始密码（默认 admin123，登录后应立即修改）
# ADMIN_PASSWORD=
