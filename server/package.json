{
  "name": "lab-checkin-server",
  "version": "1.0.0",
  "description": "实验室签到系统后端",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env.development src/index.ts",
    "dev:test": "node --watch --env-file-if-exists=.env.test src/index.ts",
    "start:test": "node --env-file-if-exists=.env.test src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "version:check": "node ../scripts/check-version.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^6.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^1.2.0"
  }
}
