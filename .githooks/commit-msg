#!/bin/sh
# 提交信息规范校验：Conventional Commits（feat/fix/chore/refactor/style/docs/test/perf/ci/build/revert）
set -e

msg="$(cat "$1" | sed '/^#/d;/^$/d' | head -n 1)"

pattern='^(feat|fix|chore|refactor|style|docs|test|perf|ci|build|revert)(\([a-zA-Z0-9/_-]+\))?!?: .{1,100}'

if ! echo "$msg" | grep -qE "$pattern"; then
  echo "提交信息不符合 Conventional Commits 规范：$msg"
  echo '格式要求：<type>(<scope>)?: <描述>，例如 feat(auth): 支持手机号登录'
  exit 1
fi
