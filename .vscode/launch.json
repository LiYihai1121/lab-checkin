{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "后端：调试 Express API（node --watch）",
            "cwd": "${workspaceFolder}/server",
            "runtimeArgs": ["--watch"],
            "program": "${workspaceFolder}/server/src/index.js",
            "skipFiles": ["<node_internal>/**"],
            "restart": true,
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "前端：Vite 开发服务器",
            "cwd": "${workspaceFolder}/web",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "前端：Edge 调试页面",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/web",
            "userDataDir": false
        }
    ],
    "compounds": [
        {
            "name": "全栈：后端 + 前端 + 浏览器",
            "configurations": [
                "后端：调试 Express API（node --watch）",
                "前端：Vite 开发服务器",
                "前端：Edge 调试页面"
            ],
            "stopAll": true
        }
    ]
}
