{
  "name": "lab-trace-web",
  "version": "1.1.0",
  "description": "LabTrace 电子实验室签到系统前端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:test": "vite --mode test",
    "build": "vite build --mode production",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version:check": "node ../scripts/check-version.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "echarts": "^6.1.0",
    "element-plus": "^2.9.1",
    "html5-qrcode": "^2.3.8",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^6.0.7",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.12"
  }
